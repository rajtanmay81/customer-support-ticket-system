DATABASE_URL=postgresql://ticket_admin:ticket_pass@localhost:5432/ticket_system
JWT_SECRET_KEY=change-this-to-a-random-secret-for-your-own-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

GEMINI_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: if set, text generation (chat replies, summaries, sentiment) uses Groq
# instead of Gemini. Embeddings/RAG still use Gemini above regardless.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
